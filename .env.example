# ことのあめ's Supabase project (its accounts; the record is kept in hg_records, read and written as the learner).
# Without these the app works on the device only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ことのあめ's address, for making an account or resetting a password (default https://polylinga.vercel.app)
NEXT_PUBLIC_KOTONOAME_URL=
# Optional: ことのあめ's Google OAuth client, once this app's addresses are among its authorized JavaScript origins
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Only for making the clips (scripts/generate-audio.mjs), never at run time. ことのおと's .env.local has them:
#   node --env-file=../作品,app/chinese/.env.local scripts/generate-audio.mjs
